{
    "name": "rsc-kit/laravel",
    "description": "React Server Components for Laravel: the renderer serves the request, Laravel answers it",
    "type": "library",
    "keywords": [
        "laravel",
        "react",
        "rsc",
        "react-server-components",
        "ssr",
        "streaming"
    ],
    "homepage": "https://github.com/rsc-kit/laravel",
    "authors": [
        {
            "name": "Ramon Malcolm",
            "homepage": "https://github.com/ramonmalcolm10"
        }
    ],
    "license": "MIT",
    "suggest": {
        "@rsc-kit/core": "The renderer, installed with npm rather than composer. This release pairs with ^0.6 — rsc:install checks the installed version and says so if it disagrees."
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "RscKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "lint:dirty": "vendor/bin/pint --dirty"
    },
    "extra": {
        "laravel": {
            "providers": [
                "RscKit\\RscKitServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
